# Copy this file to .env and fill in your own key.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional. A fast model that supports tool calling and JSON output.
GROQ_MODEL=llama-3.1-8b-instant

# Upload limits
MAX_UPLOAD_MB=5
MAX_ROWS=20000
MAX_COLUMNS=40

# Optional cost estimate, in USD per 1,000,000 tokens.
# Leave blank to show N/A. Do not guess prices in the app.
# Check the current Groq pricing page before entering numbers.
GROQ_USD_PER_MILLION_INPUT_TOKENS=
GROQ_USD_PER_MILLION_OUTPUT_TOKENS=
